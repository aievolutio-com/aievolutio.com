{
  "name": "aievolutio-site",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "predev": "npm run build:site",
    "dev": "npx http-server -c-1 dist",
    "build:site": "node scripts/prerender-site.mjs",
    "lint:js": "eslint scripts --max-warnings=0",
    "lint:css": "stylelint \"styles/**/*.css\"",
    "lint:html": "html-validate \"**/*.html\"",
    "format": "prettier -w .",
    "a11y": "pa11y-ci --config pa11yci.json",
    "lhci:ci": "lhci autorun --config=lighthouserc.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@html-validate/stylish": "^4.3.0",
    "@lhci/cli": "^0.13.0",
    "eslint": "^9.9.0",
    "html-validate": "^8.7.0",
    "pa11y-ci": "^3.1.0",
    "prettier": "^3.3.0",
    "puppeteer-core": "^25.14.0",
    "stylelint": "^16.6.0",
    "stylelint-config-standard": "^36.0.0"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  }
}
